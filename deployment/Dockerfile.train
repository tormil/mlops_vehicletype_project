FROM python:3.11-slim

WORKDIR /app

# System deps for torchvision / Pillow / opencv-style libs
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps (CPU torch is enough — minikube has no GPU passthrough on Windows)
RUN pip install --no-cache-dir \
    torch torchvision --index-url https://download.pytorch.org/whl/cpu

RUN pip install --no-cache-dir \
    timm \
    mlflow \
    pyyaml \
    pandas \
    "numpy<2" \
    scikit-learn \
    tqdm \
    pillow

# Bake source code into the image so pipeline components can run src/train.py etc.
COPY src/ /app/src/
COPY config/ /app/config/

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app:/app/src

CMD ["python", "-c", "print('vehicle-trainer image ready; override CMD with a script invocation')"]
